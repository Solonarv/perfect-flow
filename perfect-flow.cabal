cabal-version:       3.0
-- Initial package description 'perfect-flow.cabal' generated by 'cabal
-- init'.  For further documentation, see
-- http://haskell.org/cabal/users-guide/

name:                perfect-flow
version:             0.1.0.0
synopsis:            A kind of rhythm game disguised as MMO-style combat.
description:         A kind of rhythm game disguised as MMO-style combat.
bug-reports:         https://github.com/Solonarv/perfect-flow/issues
license:             GPL-3.0-or-later
license-files:       COPYING
author:              Solonarv
maintainer:          nstamm@gmx.de
copyright:           2026 Nimue Eris Wesemael
category:            Game
build-type:          Simple
extra-source-files:  CHANGELOG.md, README.md

source-repository head
  type:     git
  location: https://github.com/Solonarv/perfect-flow.git

common language
  default-language: GHC2021
  default-extensions: ImportQualifiedPost, DerivingVia
                    , DuplicateRecordFields, NamedFieldPuns, RecordWildCards, NoFieldSelectors, OverloadedRecordDot
                    , TypeApplications, DataKinds, LambdaCase, OrPatterns, BlockArguments, FlexibleContexts
                    , MultiWayIf, StandaloneKindSignatures, TypeAbstractions, ScopedTypeVariables, TypeOperators
                    , FunctionalDependencies, OverloadedLabels
                    -- the intended migration path doesn't even exist yet
  ghc-options:      -Wno-ambiguous-fields

executable perfect-flow
  import: language
  main-is:             Main.hs
  hs-source-dirs:      exe
  build-depends:       base >=4.22 && <5
                     , perfect-flow

library
  import: language
  exposed-modules:     PF.Main, PF.AppM, PF.Simulation, PF.Simulation.Notation, PF.Levels.ArcaneWizard, PF.Levels.Corruptor
                     , PF.Render, PF.Data.Number, PF.Random, PF.Simulation.Level, PF.Data.Named
                     , PF.Simulation.Level.Consistency, PF.Data.HierarchicalTable, PF.Locale, PF.Data.Symbol
                     -- , PF.Render.Text
  hs-source-dirs:      src
  build-depends:       StateVar ^>=1.2.2
                     , bytestring ^>=0.12.2.0
                     , unordered-containers ^>=0.2.21, hashable ^>= 1.5.1.0
                     , random ^>=1.3.1, symbolize ^>= 1.0.3.1
                     , base >= 4.22 && <5
                     , mtl ^>= 2.3.1, text ^>= 2.1.4, containers ^>= 0.8.1
                     , sdl2 ^>= 2.5.6.1, sdl2-ttf ^>= 2.1.3
                     , linear ^>= 1.23.3,  misc-2d-utils, lens ^>= 5.3.6
                     , gl-utils
                     , gl ^>= 0.9.1, aeson ^>= 2.3.2.0
                     , perfect-flow:orphans
  default-language:    Haskell2010

library orphans
  import: language
  exposed-modules:     Orphans
  hs-source-dirs:      orphans
  build-depends:       base, aeson, symbolize

library gl-utils
  import: language
  exposed-modules:     ForeignUtils, Graphics.GL.Shaders, Graphics.GL.Shaders2D
                     , Graphics.GL.Primitives2D
  hs-source-dirs:      gl-utils
  build-depends:       base
                     , gl
                     , bytestring
                     , file-embed
                     , linear
                     , misc-2d-utils
  default-language:    Haskell2010

library misc-2d-utils
  import: language
  exposed-modules:     Misc.AABB
  hs-source-dirs:      misc-2d-utils
  build-depends:       base
                     , linear ^>= 1.23.3,
  default-language:    Haskell2010
